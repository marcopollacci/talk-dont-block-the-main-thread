</p-slide>

<p-slide>
  <h3>😶‍🌫️ <span class="main-gradient">Zoneless by default</span></h3>
  <ul class="space mid-dimension" style="--web-day-ul-space: 0.2em">
    <li>
      ⚡ <span class="main-sub-gradient">OnPush</span> is the default change
      detection strategy
    </li>
    <li p-fragment p-effect="from left">
      🚫 No more <span class="main-sub-gradient">Zone.js</span> patching your
      async callbacks
    </li>
    <p-fragment p-effect="highlight red">
      <li>
        ⚠️ <code>worker.onmessage</code> updating a plain property
        <span class="main-sub-gradient"> won't refresh the UI</span>
      </li>
    </p-fragment>
    <p-fragment p-effect="highlight green">
      <li>
        ✅ Writing into a <span class="main-sub-gradient">signal</span> will
      </li>
    </p-fragment>
  </ul>
</p-slide>


<p-slide>
  <h3>🧃 <span class="main-gradient">resource() — now stable</span></h3>
  <ul class="space mid-dimension" style="--web-day-ul-space: 0.2em">
    <li p-fragment p-effect="from left">
      📦 Async data <span class="main-sub-gradient">inside the signal graph</span>
    </li>
    <li p-fragment p-effect="from right">
      🔁 Re-runs automatically when its
      <span class="main-sub-gradient">params signal</span> changes
    </li>
    <li p-fragment p-effect="zoom">
      🎁 <code>isLoading()</code>, <code>error()</code>,
      <code>value()</code> — <span class="main-sub-gradient">for free</span>
    </li>
    <li p-fragment p-effect="from below">
      🙅‍♂️ No subscribe, no unsubscribe,
      <span class="main-sub-gradient">no leaks</span>
    </li>
  </ul>
</p-slide>

<p-slide follow-fragments>
  <h4 style="margin-block-end: 0.5em" class="center">Let&#39;s Code 👨‍💻</h4>
  <pre class="small-line" data-label-file="worker-resource.service.ts">
    <code is:raw class="language-javascript">
  @Service() // 👋 bye bye @Injectable({ providedIn: 'root' })
  export class WorkerResourceService {
    readonly #worker = new Worker(
      new URL('./worker-test.worker', import.meta.url)
    );</code>
    <p-fragment>
      <code is:raw class="language-javascript">
    run(input: Signal&lt;string | undefined>) {
      return resource({
        params: () => input(),</code>
    </p-fragment>
    <p-fragment>
      <code is:raw class="language-javascript">
        loader: ({ params }) =>
          new Promise&lt;string>((resolve, reject) => {
            this.#worker.onmessage = ({ data }) => resolve(data);
            this.#worker.onerror = (error) => reject(error);
            this.#worker.postMessage(params);
          }),
      });
    }
  }</code>
    </p-fragment>
  </pre>
</p-slide>

<p-slide>
  <h4 style="margin-block-end: 0.5em" class="center">Let&#39;s Code 👨‍💻</h4>
  <pre class="small-line" data-label-file="home.component.ts">
    <code is:raw class="language-javascript">
  export class HomeComponent {
    readonly #workerService = inject(WorkerResourceService);

    readonly input = signal&lt;string | undefined>(undefined);
    readonly task = this.#workerService.run(this.input);

    start() {
      this.input.set(`daje-${Date.now()}`); // 🔁 triggers the loader
    }
  }</code>
  </pre>
</p-slide>

<p-slide>
  <h4 style="margin-block-end: 0.5em" class="center">
    The template does the rest ✨
  </h4>
  <pre class="small-line" data-label-file="home.component.html">
    <code is:raw class="language-javascript">
  &lt;button (click)="start()">Run heavy task&lt;/button>

  @if (task.isLoading()) {
    &lt;p>⏳ crunching numbers…&lt;/p>
  } @else if (task.error()) {
    &lt;p>💥 something went wrong&lt;/p>
  } @else if (task.hasValue()) {
    &lt;p>✅ {{ task.value() }}&lt;/p>
  }</code>
  </pre>
</p-slide>

