---
import CodeWindow from "../components/CodeWindow.astro";
import Meme from "../components/Meme.astro";
import PNotes from "../components/PNotes.astro";
import grusPlan from "../img/memes/grus-plan.jpg";
---

<p-slide layout="center" autoplay timing="550">
  <h2 style="margin-block-end: 0">
    <span gradient>Angular 22: enter the Signals</span>
    <span aria-hidden="true">🚦</span>
  </h2>
  <h4 p-fragment p-effect="from below" style="font-style: italic">
    <span gradient="sub">Do we still need Observables?</span>
    <span aria-hidden="true">🤨</span>
  </h4>
</p-slide>

<p-slide>
  <h3>
    <span aria-hidden="true">😶‍🌫️</span>
    <span gradient>Zoneless by default</span>
  </h3>
  <ul density="spaced" text="mid">
    <li p-fragment p-effect="from right">
      ⚡ <span gradient="sub">OnPush</span> is the default (old
      <code>Default</code> is now <code>Eager</code>)
    </li>
    <li p-fragment p-effect="from left">
      🚫 No more <span gradient="sub">Zone.js</span> patching your async
      callbacks
    </li>
    <li p-fragment p-effect="zoom">
      ⚠️ <code>onmessage</code> setting a plain field
      <span gradient="sub"> won't refresh the UI</span>
    </li>
    <li p-fragment p-effect="from below">
      ✅ Writing into a <span gradient="sub">signal</span> will
    </li>
  </ul>
  <PNotes>
    <p>
      Zoneless is the default for new apps since v21; v22 makes OnPush the
      default and renames the old Default strategy to Eager (ng update adds
      Eager to components that had no strategy).
    </p>
    <p>
      ng g service now generates @Service() (use --injectable for the old
      decorator). @Service() services must use inject(), no constructor DI.
    </p>
  </PNotes>
</p-slide>

<p-slide layout="center">
  <Meme
    src={grusPlan}
    alt="Gru's plan meme: Gru presents a four-step plan on a flip chart and stares at the last step in horror"
    size="8.5em"
    captionSize="0.3em"
    captionBg="transparent"
  >
    <span caption style="--x: 38%; --y: 30%">
      Move heavyTask
      <br />
      to a worker
    </span>
    <span caption style="--x: 88%; --y: 30%">
      <code>onmessage</code>
      <br />
      sets a field
    </span>
    <span caption style="--x: 38.5%; --y: 78%">
      The UI
      <br />
      never updates
    </span>
    <span caption style="--x: 88%; --y: 78%">
      The UI
      <br />
      never updates
    </span>
  </Meme>
  <PNotes>
    <p>Don't explain the meme. Pause, let it land, move on.</p>
  </PNotes>
</p-slide>

<p-slide>
  <h3>
    <span aria-hidden="true">🧃</span>
    <span gradient>resource() — now stable</span>
  </h3>
  <ul density="spaced" text="mid">
    <li p-fragment p-effect="from left">
      📦 Async data <span gradient="sub">inside the signal graph</span>
    </li>
    <li p-fragment p-effect="zoom">
      🔁 Re-runs automatically when its
      <span gradient="sub">params signal</span> changes
    </li>
    <li p-fragment p-effect="from below">
      🎁 <code>isLoading()</code>, <code>error()</code>, <code>value()</code> —{" "}
      <span gradient="sub">for free</span>
    </li>
    <li p-fragment p-effect="from right">
      🙅‍♂️ No subscribe, no unsubscribe,
      <span gradient="sub">no leaks</span>
    </li>
  </ul>
</p-slide>

<p-slide>
  <h4 layout="center" style="margin-block-end: 0.5em">
    Let's Code <span aria-hidden="true">👨‍💻</span>
  </h4>
  <CodeWindow
    is:raw
    file="worker-resource.service.ts"
    lang="ts"
    lines={10}
    fragments="7-9, 10-18"
  >
    @Service() // 👋 bye bye @Injectable({ providedIn: 'root' })
    export class WorkerResourceService {
      readonly #worker = new Worker(
        new URL('./worker-test.worker', import.meta.url)
      );

      run(input: Signal<string | undefined>) {
        return resource({
          params: () => input(),
          loader: ({ params }) =>
            new Promise<string>((resolve, reject) => {
              this.#worker.onmessage = ({ data }) => resolve(data);
              this.#worker.onerror = (error) => reject(error);
              this.#worker.postMessage(params);
            }),
        });
      }
    }
  </CodeWindow>
  <PNotes>
    <p>
      resource() needs an injection context: it works here because run() is
      called from a component field initializer. Called anywhere else, pass{" "}
      {"{"}
      injector {"}"} in the options.
    </p>
    <p>
      Production tip: the loader also receives an abortSignal. If params change
      while the worker is busy, the previous promise never settles here: listen
      to abortSignal and reject, and tag messages with an id if requests can
      overlap.
    </p>
  </PNotes>
</p-slide>

<p-slide>
  <h4 layout="center" style="margin-block-end: 0.5em">
    Let's Code <span aria-hidden="true">👨‍💻</span>
  </h4>
  <CodeWindow is:raw file="home.component.ts" lang="ts">
    export class HomeComponent {
      readonly #workerService = inject(WorkerResourceService);

      readonly input = signal<string | undefined>(undefined);
      readonly task = this.#workerService.run(this.input);

      start() {
        this.input.set(`daje-${Date.now()}`); // 🔁 triggers the loader
      }
    }
  </CodeWindow>
</p-slide>

<p-slide>
  <h4 layout="center" style="margin-block-end: 0.5em">
    The template does the rest <span aria-hidden="true">✨</span>
  </h4>
  <CodeWindow is:raw file="home.component.html" lang="angular-html">
    <button (click)="start()">Run heavy task</button>

    @if (task.isLoading()) {
      <p>⏳ crunching numbers…</p>
    } @else if (task.error()) {
      <p>💥 something went wrong</p>
    } @else if (task.hasValue()) {
      <p>✅ {{ task.value() }}</p>
    }
  </CodeWindow>
</p-slide>

<p-slide>
  <h3>
    <span aria-hidden="true">🌰</span>
    <span gradient>resource() in a nutshell</span>
  </h3>
  <ul density="spaced" text="mid">
    <li p-fragment p-effect="zoom">
      📨 <span gradient="sub">One-shot</span> work: loading &amp; error built in
    </li>
    <li p-fragment p-effect="from below">
      🌊 Streams? Still <span gradient="sub">Observable / rxResource</span>
    </li>
    <li p-fragment p-effect="from right">
      🧭 Pick by the <span gradient="sub">shape of your data</span>, not habit
    </li>
  </ul>
</p-slide>
