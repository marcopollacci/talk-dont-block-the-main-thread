---
import { Image } from "astro:assets";
import refs from "../img/refs.png";
---

<p-slide class="cover">
  <h1>Don't Block the Main Thread</h1>
  <p-note class="center">
    <h6>How to avoiding long tasks on the main thread</h6>
  </p-note>
  <Image
    src={refs}
    alt="reggio emilia full stack logo"
    class="alter-image-size"
    style="--image-start-size: 3em;margin-block-start: 3rem;box-shadow: inset 0 0 0 1000px rgb(255 255 255);border-radius: 1rem; border: 1px solid #999999"
  />
  <p-note class="center bottom-fist-page text-sub-section">
    <span>Marco Pollacci</span>
    <span>12/05/2025 - Reggio Emilia Full Stack</span>
  </p-note>
</p-slide>
