---
import { Image } from "astro:assets";
import refs from "../img/refs.png";
---

<p-slide cover>
  <h1>Don't Block the Main Thread</h1>
  <p-note layout="center">
    <h6>How to avoiding long tasks on the main thread</h6>
  </p-note>
  <Image
    src={refs}
    alt="Reggio Emilia Full Stack logo"
    style="margin-block-start: 3rem; background-color: white; border: 1px solid oklch(0.68 0 0); border-radius: 1rem"
  />
  <footer layout="center" gradient="sub">
    <span>Marco Pollacci</span>
    <span>12/05/2026 - Reggio Emilia</span>
  </footer>
</p-slide>
