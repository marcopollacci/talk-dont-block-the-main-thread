---
import { Image } from "astro:assets";
import qrRepo from "../img/qr_repo.png";
const repoLink = "https://github.com/marcopollacci/web-worker-angular-example";
---

<p-slide layout="center">
  <h2 style="margin-block-end: 0.3em">You can see the code on</h2>
  <p-note style="margin-block-end: 0.5em">
    <Image
      src={qrRepo}
      alt="QR code to the demo repository"
      style="--size: 8em"
    />
  </p-note>
  <p-note>
    <a href={repoLink}>{repoLink}</a>
  </p-note>
</p-slide>
