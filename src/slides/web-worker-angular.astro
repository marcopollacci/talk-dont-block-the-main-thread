---
import { Image } from "astro:assets";
import CodeWindow from "../components/CodeWindow.astro";
import PNotes from "../components/PNotes.astro";
import angularLogo from "../img/angular-logo.png";
---

<p-slide layout="center">
  <Image src={angularLogo} alt="Angular logo" style="--size: 6.5em" />
  <h3 gradient style="margin-block-start: 0.3em">
    Angular Web Workers
  </h3>
</p-slide>
<p-slide cover>
  <h1 gradient="sub">Angular CLI allows us to generate new Web Worker</h1>
</p-slide>
<p-slide>
  <h3 style="margin-block-end: 0.9em">
    <span aria-hidden="true">⚙️</span> <span gradient="sub">Angular CLI</span>
  </h3>
  <ul density="spaced" style="font-weight: 100">
    <li>
      🆕 <span gradient>Create new file</span>
    </li>
    <li p-fragment p-effect="from left">
      🆕 Create new file <span gradient>tsconfig.worker.json</span>
      <i>(only first time)</i>
    </li>
    <li p-fragment p-effect="from right">
      🔄 Update <span gradient>angular.json</span>
      <i>(only first time)</i>
    </li>
    <li p-fragment p-effect="zoom">
      🔄 <span gradient>Update</span> class file only if web worker has the same
      name
    </li>
  </ul>
  <PNotes>
    <p>
      last point example:
      <br />
      <u>worker-test</u>.service.ts --> <u>worker-test</u>.worker.ts
    </p>
  </PNotes>
</p-slide>
<p-slide>
  <h4 style="margin-block-end: 0.5em">
    <span aria-hidden="true">⚙️</span> <span gradient="sub">Angular CLI</span>
  </h4>
  <CodeWindow is:raw file="terminal" lang="bash" fragments="3, 4, 5, 6">
    ng g web-worker services/worker-test

    CREATE src/app/services/worker-test.worker.ts (157 bytes)
    CREATE tsconfig.worker.json (334 bytes)
    UPDATE angular.json (2946 bytes)
    UPDATE src/app/services/worker-test.service.ts (537 bytes)
  </CodeWindow>
  <PNotes>
    <p>
      <b>angular.json:</b> new property WebWorkerTsConfig inside build -->
      options that refer to tsconfig.worker.json
    </p>
  </PNotes>
</p-slide>
<p-slide>
  <CodeWindow is:raw file="worker-test.worker.ts" lang="ts">
    /// <reference lib="webworker" />

    addEventListener('message', ({ data }) => {
      const response = `worker response to ${data}`;
      postMessage(response);
    });
  </CodeWindow>
  <PNotes>
    The /// &lt;reference lib="webworker" /> directive is a TypeScript
    declaration that tells the compiler to include the type definitions specific
    to Web Workers. <br />
    <br />
    What is it for? By default, TypeScript uses DOM types, which include APIs
    like document, window, etc. However, Web Workers do not have access to these
    APIs (for example, window does not exist in a worker). In Angular, when you
    create a Web Worker, this directive ensures that TypeScript uses the correct
    set of types, providing only the APIs available in a Web Worker, such as
    postMessage, onmessage, and other global objects typical of a worker.
  </PNotes>
</p-slide>
<p-slide>
  <CodeWindow
    is:raw
    file="worker-test.worker.ts"
    lang="ts"
    size="small"

    fragments="6-8, 9-12, 13-16"
  >
    // ...
    export class WorkerTestService {
      constructor() { }
    }

    if (typeof Worker !== 'undefined') {
      // Create a new
      const worker = new Worker(new URL('./worker-test.worker', import.meta.url));
      worker.onmessage = ({ data }) => {
        console.log(`page got message: ${data}`);
      };
      worker.postMessage('hello');
    } else {
      // Web Workers are not supported in this environment.
      // You should add a fallback so that your program still executes correctly.
    }
  </CodeWindow>
</p-slide>
<p-slide layout="center" autoplay timing="600">
  <h1 gradient>Let's see some example code!</h1>
  <p-fragment>
    <img src="/img/omg.gif" alt="Animated “OMG” reaction" style="--size: 6em" />
  </p-fragment>
</p-slide>
<p-slide>
  <h4 layout="center" style="margin-block-end: 0.5em">
    Let's Code <span aria-hidden="true">👨‍💻</span>
  </h4>
  <CodeWindow is:raw file="worker-test.worker.ts" lang="ts">
    addEventListener('message', ({ data }) => {
      heavyTask();
      postMessage(`done "${data}" task`);
    });
  </CodeWindow>
  <p-fragment>
    <span
      sketch-circle
      style="--sketch-height: 1.3em; position: absolute; inset-block-end: 6.51em; inline-size: 6em; inset-inline-start: 1.69em; z-index: 1"
    ></span>
  </p-fragment>
</p-slide>
<p-slide>
  <h4 layout="center" style="margin-block-end: 0.5em">
    Let's Code <span aria-hidden="true">👨‍💻</span>
  </h4>
  <CodeWindow
    is:raw
    file="worker-test.service.ts"
    lang="ts"
    lines={12}
    fragments="15-25"
  >
    //...
    export class WorkerTestService {
      #worker!: Worker;

      constructor() {
        this.createWorker();
      }

      createWorker() {
        this.#worker = new Worker(
          new URL('./worker-test.worker.ts', import.meta.url)
        );
      }

      doHeavyWork(data: string): Observable<string> {
        return new Observable((observer) => {
          this.#worker.onmessage = ({ data }: MessageEvent<string>) => {
            observer.next(data);
            observer.complete();
          };
          this.#worker.onerror = (error) => observer.error(error);
          this.#worker.postMessage(data);
        });
      }
    }
  </CodeWindow>
  <p-fragment>
    <span
      sketch-circle
      style="--sketch-height: 2.3em; position: absolute; inset-block-end: 7.6em; inline-size: 9.03em; inset-inline-start: 1.72em; z-index: 1"
    ></span>
  </p-fragment>
  <p-fragment>
    <span
      sketch-circle
      style="--sketch-height: 1.4em; position: absolute; inset-block-end: 5.28em; inline-size: 6.92em; inset-inline-start: 13.76em; z-index: 1"
    ></span>
  </p-fragment>
</p-slide>
<p-slide>
  <h4 layout="center" style="margin-block-end: 0.5em">
    Let's Code <span aria-hidden="true">👨‍💻</span>
  </h4>
  <CodeWindow is:raw file="home.component.ts" lang="ts">
    // ...
    export class HomeComponent {
      readonly #workerService = inject(WorkerTestService);

      startHeavyWorkInWorker() {
        this.#workerService
          .doHeavyWork('daje')
          .subscribe((data) => console.log(data)); // done "daje" task
      }
    }
  </CodeWindow>
  <p-fragment>
    <span
      sketch-circle
      style="--sketch-height: 2em; position: absolute; inset-block-end: 4.69em; inline-size: 6em; inset-inline-start: 2.69em; z-index: 1"
    ></span>
  </p-fragment>
</p-slide>
<p-slide layout="center">
  <h2 style="margin-block-end: 0.5em">
    <span gradient="sub">Web Worker Pool</span>
  </h2>
  <span aria-hidden="true" style="font-size: 1.4em">
    📚
  </span>
</p-slide>
<p-slide>
  <h3>
    <span aria-hidden="true">📚</span>{" "}
    <span gradient="sub">Web Worker Pool</span>
  </h3>
  <ul density="spaced" style="font-weight: 100">
    <li>
      ♻️ <span gradient>Reduced Overhead</span>
    </li>
    <li p-fragment>
      💪 <span gradient>Efficient Resource Management</span>
    </li>
    <li p-fragment>
      🎢 <span gradient>Scalability</span>
    </li>
  </ul>
  <PNotes>
    <span style="font-size: 0.8em">
      A Web Worker Pool is a technique where you create and manage a group (or
      "pool") of pre-initialized Web Workers that are ready to handle tasks on
      demand. Instead of creating and destroying Web Workers dynamically (which
      is resource-intensive), the pool maintains a set of workers that can be
      reused, improving performance and efficiency.
    </span>
    <ul style="font-size: 0.8em">
      <li>
        Reduced Overhead: Creating a Web Worker is expensive in terms of time
        and resources. A pool avoids repeatedly creating and destroying workers.
      </li>
      <li>
        Efficient Resource Management: Workers are reused, preventing memory
        leaks and excessive resource consumption.
      </li>
      <li>
        Scalability: You can control the number of active workers, ensuring the
        application adapts to the device's capabilities.
      </li>
    </ul>
  </PNotes>
</p-slide>
<p-slide layout="center">
  <h3 style="margin-block-end: 0.5em">
    <span gradient="sub">How Does a Web Worker Pool Work?</span>
  </h3>
  <span aria-hidden="true" style="font-size: 1.4em">
    ( ꩜ ᯅ ꩜;)
  </span>
</p-slide>
<p-slide>
  <h4>
    <span gradient="sub">Pool worker loop</span>{" "}
    <span aria-hidden="true">🔁</span>
  </h4>
  <div hand-drawing="row" layout="center">
    <p-fragment>
      <span box>Pool Initialization</span>
    </p-fragment>
    <p-fragment>
      <span arrow right></span> <span box>Task Assignment</span>
    </p-fragment>
    <p-fragment>
      <span arrow right></span> <span box>Worker Release</span>
    </p-fragment>
  </div>
</p-slide>
<p-slide>
  <h4 layout="center" style="margin-block-end: 0.5em">
    Let's Code <span aria-hidden="true">👨‍💻</span>
  </h4>
  <CodeWindow
    is:raw
    file="worker-pool.service.ts"
    lang="ts"
    size="small"
    lines={15}
    fragments="9-16, 18-21"
  >
    const POOL_SIZE = 4;
    export class WorkerPoolService {
      #workers: Worker[] = [];

      constructor() {
        this.createPoolWorkers();
      }

      createPoolWorkers() {
        for (let i = 0; i < POOL_SIZE; i++) {
          const worker = new Worker(
            new URL('./worker-test.worker.ts', import.meta.url)
          );
          this.#increaseWorkerPool(worker);
        }
      }

      #increaseWorkerPool(worker: Worker) {
        this.#workers.push(worker);
      }
    }
  </CodeWindow>
  <p-fragment>
    <span
      sketch-circle
      style="--sketch-height: 1.3em; position: absolute; inset-block-end: 8.82em; inline-size: 4.94em; inset-inline-start: 6.43em; z-index: 1"
    ></span>
  </p-fragment>
</p-slide>
<p-slide>
  <h4 layout="center" style="margin-block-end: 0.5em">
    Let's Code <span aria-hidden="true">👨‍💻</span>
  </h4>
  <CodeWindow
    is:raw
    file="worker-pool.service.ts"
    lang="ts"
    size="small"
    lines={15}
  >
    export class WorkerPoolService {
      //...
      getWorker(data: string): Observable<string> | null {
        const worker = this.#workers.pop();
        if (!worker) return null;
        return new Observable((observer) => {
          worker.onmessage = ({ data }: MessageEvent<string>) => {
            observer.next(data);
            observer.complete();
            this.#increaseWorkerPool(worker);
          };
          worker.onerror = (error) => observer.error(error);
          worker.postMessage(data);
        });
      }
    }
  </CodeWindow>
  <p-fragment>
    <span
      sketch-circle
      style="--sketch-height: 1.3em; position: absolute; inset-block-end: 8.62em; inline-size: 5.18em; inset-inline-start: 6.19em; z-index: 1"
    ></span>
  </p-fragment>
  <p-fragment>
    <span
      sketch-circle
      style="--sketch-height: 1.3em; position: absolute; inset-block-end: 5.02em; inline-size: 8.31em; inset-inline-start: 3.54em; z-index: 1"
    ></span>
  </p-fragment>
</p-slide>

<style>
  [hand-drawing],
  [hand-drawing] p-fragment {
    gap: 0;
  }
</style>
