---
import { Image } from "astro:assets";
import Speaker from "../components/Speaker.astro";
const { qrLink, urlLink, qrLinkRating, QuestionsSlide, RepoSlide, meReloaded } =
  Astro.props;
---

<p-slide>
  <img
    alt="Animated “That's all folks!” closing card"
    src="/img/thatsall.gif"
    style="--size: 100%"
  />
</p-slide>
<p-slide layout="center">
  <h2 style="margin-block-end: 0.3em">You can see this slide on</h2>
  {qrLink ? (
    <p-note style="margin-block-end: 0.5em">
      <Image src={qrLink} alt="QR code to these slides" style="--size: 8em" />
    </p-note>
  ) : (
    <p-note todo style="margin-block-end: 0.5em">
      adding qr image!
    </p-note>
  )}
  {urlLink ? (
    <p-note>
      <a href={urlLink}>{urlLink}</a>
    </p-note>
  ) : (
    <p-note todo>adding link</p-note>
  )}
</p-slide>
{RepoSlide && <RepoSlide />}
{QuestionsSlide && <QuestionsSlide />}
<p-slide layout="two-columns">
  <Speaker heading="Thank you again!" {meReloaded} />
  <p-note card gradient="cover">
    <h5>Leave some feedback</h5>
    {qrLinkRating ? (
      <Image
        src={qrLinkRating}
        alt="QR code to rate this talk"
        style="--size: 8.5em; background-color: white"
      />
    ) : (
      <span todo>adding qr image!</span>
    )}
  </p-note>
</p-slide>
