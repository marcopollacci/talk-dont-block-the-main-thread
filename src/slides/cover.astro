---
import Speaker from "../components/Speaker.astro";
// Inlined (not <Image>) so the gradient follows the theme's cover tokens
import QrLink from "../img/qr_link.svg";
const { meReloaded } = Astro.props;
---

<p-slide layout="two-columns" autoplay>
  <Speaker heading="Hello Folks!" {meReloaded} />
  <QrLink role="img" aria-label="Speaker's QR code" style="--size: 10.5em" />
</p-slide>
