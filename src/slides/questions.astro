---
import CodeWindow from "../components/CodeWindow.astro";
---

<p-slide>
  <h5 layout="center" style="margin-block-end: 1em">
    <span gradient>Questions?</span> <span aria-hidden="true">🤔</span>
  </h5>
  <CodeWindow is:raw file="questions.js" lang="js">
    self.onmessage = async (event) => {
      const { data: question } = event;

      const answer = await answer(question);
      self.postMessage(`The answer is: ${answer}`);
    };
  </CodeWindow>
</p-slide>
