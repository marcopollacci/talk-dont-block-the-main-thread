---
import { Image } from "astro:assets";
import CodeWindow from "../components/CodeWindow.astro";
import PNotes from "../components/PNotes.astro";
import freezing from "../img/freezing-man.png";
import spongy from "../img/problem-solution.jpg";
---

<p-slide layout="center" autoplay timing="550">
  <h2 gradient>The Freezing problem</h2>
  <p-fragment>
    <Image
      src={freezing}
      alt="A man frozen in a block of ice"
      style="--size: 7em"
    />
  </p-fragment>
</p-slide>
<p-slide>
  <h4 layout="center" gradient style="margin-block-end: 0.5em">
    The Event Loop
  </h4>
  <figure>
    <img
      src="/img/event-loop.gif"
      alt="Animation of the JavaScript event loop moving tasks from the queues to the call stack"
      style="--size: 8em; border-radius: 0.3em"
    />
    <figcaption>
      <cite>
        <a
          href="https://dev.to/arslanyounis/how-javascript-event-loop-works-5604"
          target="_blank"
        >
          credits: Arslan Younis
        </a>
      </cite>
    </figcaption>
  </figure>
  <PNotes>
    Event Loop order:
    <p>Synchronous Code Execution</p>
    <p>Microtasks Execution (promise callbacks)</p>
    <p>Macro Task Execution (setTimeout, setInterval)</p>
  </PNotes>
</p-slide>
<p-slide>
  <h1 layout="center" gradient="sub">
    BUT
  </h1>
</p-slide>
<p-slide autoplay timing="800">
  <h4 layout="center" gradient="sub" style="margin-block-end: 0.5em">
    The Synchronous code
  </h4>
  <p-fragment timing-start="900">
    <CodeWindow is:raw file="heavy-task.js" lang="js" size="small">
      const heavyTask = () => {
        for (let i = 0; i < 10000000000; i++) {
          //do something useful
        }
      };
    </CodeWindow>
  </p-fragment>
  <p-fragment timing-start="1400">
    <h4 layout="center" gradient="sub" style="margin-block-start: 0.5em">
      block the call stack!
    </h4>
  </p-fragment>
</p-slide>
<p-slide>
  <Image
    src={spongy}
    alt="SpongeBob meme: the problem and the solution"
    style="--size: 8em; border-radius: 0.3em"
  />
</p-slide>

<style>
  /* Credits under the event loop animation */
  figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0;
  }

  figcaption {
    margin-block-start: 0.8em;
    font-size: 0.3em;
    color: oklch(0.537 0.002 17.2);

    cite {
      font-style: normal;
    }
  }
</style>
