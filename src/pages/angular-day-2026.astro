---
import angularFav from "../img/angularday-favicon32x32.webp";
import qrRating from "../img/qr_rating_angularday2026.png";
import qrSlide from "../img/qr_slide_angularday2026.png";
import Layout from "../layouts/Layout.astro";
import Ai from "../slides/ai.astro";
import CoverAngularday2026 from "../slides/cover-angularday2026.astro";
import Cover from "../slides/cover.astro";
import Intro from "../slides/intro.astro";
import Questions from "../slides/questions.astro";
import Repo from "../slides/repo.astro";
import SignalsSection from "../slides/signals-section.astro";
import Thanks from "../slides/thanks.astro";
import TheProblem from "../slides/the-problem.astro";
import WebWorkerAngular from "../slides/web-worker-angular.astro";
import WebWorkerDeep from "../slides/web-worker-deep.astro";
import WebWorkerIntro from "../slides/web-worker-intro.astro";
import WebWorkerOutro from "../slides/web-worker-outro.astro";
const favIcon = angularFav.src;
// Slides unlock on this day; until then the page counts down to it
// (in dev, preview that page with ?coming-soon)
const releaseDate = "2026-11-20";
const canRender = import.meta.env.DEV || new Date(releaseDate) < new Date();
const metaData = {
  title: "Don't block the main thread",
  description: "How to avoid long tasks on the main thread.",
  image: "og-image.png",
  site: "https://talk-dont-block-the-main-thread.marcotalk.dev/angular-day-2026/",
};
---

<Layout
  {canRender}
  {releaseDate}
  {favIcon}
  {metaData}
  talkMinutes={40}
  theme="angularday"
>
  <CoverAngularday2026 />
  {canRender && (
    <>
      <Cover />
      <Intro />
      <TheProblem />
      <WebWorkerIntro />
      <WebWorkerDeep />
      <WebWorkerAngular />
      <SignalsSection />
      <Ai />
      <WebWorkerOutro />
      <Thanks
        QuestionsSlide={Questions}
        RepoSlide={Repo}
        qrLinkRating={qrRating}
        qrLink={qrSlide}
        urlLink={metaData.site}
      />
    </>
  )}
</Layout>
